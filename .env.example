# =====================================================================
# DUTY LOGGER — Biến môi trường mẫu
# Copy file này thành .env rồi điền giá trị thực
# TUYỆT ĐỐI KHÔNG commit file .env lên git
# =====================================================================

# ----- Discord Bot -----
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
# URL callback sau khi đăng nhập OAuth2 (điền domain VPS của bạn)
DISCORD_REDIRECT_URI=https://your-vps-domain/oauth/callback

# ----- PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=duty_logger
DB_USER=duty_user
DB_PASSWORD=your_strong_password_here
# SQLAlchemy async URL (tự build từ các biến trên — không cần sửa)
# DATABASE_URL=postgresql+asyncpg://duty_user:password@localhost:5432/duty_logger

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ----- JWT / Auth -----
# Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_64char_hex_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Mã hoá trường nhạy cảm (Fernet) -----
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# ----- HMAC ký file export -----
# Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=your_hmac_secret_here

# ----- Backup DB passphrase (GPG symmetric AES256) -----
# CHỈ dùng cho scripts/backup_db.sh. KHÔNG dùng chung với HMAC_SECRET.
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_PASSPHRASE=your_backup_passphrase_here

# ----- Web Dashboard -----
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Chỉ cho phép domain nội bộ/VPS truy cập (CORS)
ALLOWED_ORIGINS=https://your-vps-domain
# Đặt False khi production
DEBUG=True

# ----- Export file -----
# Thư mục lưu file export tạm (nằm ngoài webroot)
EXPORT_DIR=/srv/duty-logger/exports
# File export tự xóa sau bao nhiêu phút
EXPORT_TTL_MINUTES=10

# ----- Timezone mặc định -----
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ----- Rate limit -----
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_EXPORT=2/5minutes
RATE_LIMIT_LOGIN=5/minute
