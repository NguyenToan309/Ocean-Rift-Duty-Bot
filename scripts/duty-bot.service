# systemd service cho Discord Bot (nếu không dùng Docker)
# Đặt tại: /etc/systemd/system/duty-bot.service
# Enable: sudo systemctl enable --now duty-bot

[Unit]
Description=Duty Logger Discord Bot
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=duty
WorkingDirectory=/opt/duty-logger
EnvironmentFile=/opt/duty-logger/.env
ExecStart=/opt/duty-logger/venv/bin/python -m bot.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Bảo mật: không cho phép leo quyền
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
